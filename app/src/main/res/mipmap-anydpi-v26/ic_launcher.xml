<?xml version="1.0" encoding="utf-8"?>
<!--
    The background layer is the whole artwork, scaled so the mascot sits inside
    the safe circle, on a field that continues the picture's own border. Nothing
    is cut out of the JPEG, so there is no halo, no see-through body and no
    leftover shadow. The foreground is empty, which the adaptive icon allows.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>

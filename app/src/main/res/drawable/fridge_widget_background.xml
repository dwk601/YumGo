<?xml version="1.0" encoding="utf-8"?>
<!-- The widget always uses the app's light palette, so the card paints its own colors. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#F7F6F2" />
    <stroke
        android:width="1dp"
        android:color="#E0DFD9" />
    <corners android:radius="20dp" />
</shape>
